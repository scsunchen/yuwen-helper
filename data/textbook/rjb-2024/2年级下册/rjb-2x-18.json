 "text": [
  "绝句",
  "[唐] 杜甫",
  "两个黄鹂鸣翠柳，一行白鹭上青天。",
  "窗含西岭千秋雪，门泊东吴万里船。",
  "",
  "晓出净慈寺送林子方",
  "[宋] 杨万里",
  "毕竟西湖六月中，风光不与四时同。",
  "接天莲叶无穷碧，映日荷花别样红。"
 ],
 "summary": "《绝句》描绘了草堂周围明媚秀丽的春色；《晓出净慈寺送林子方》描绘了西湖六月荷花盛开、碧叶连天的壮美景色。",
 "centerThought": "感受诗人笔下大自然的美丽，体会诗人对自然、对生活的热爱。",
 "segments": [
  {
   "text": "两个黄鹂鸣翠柳，一行白鹭上青天。",
   "note": "写近景和动态。黄、翠、白、青四种颜色，有声有色，画面明丽。"
  },
  {
   "text": "窗含西岭千秋雪，门泊东吴万里船。",
   "note": "写远景。「含」字把窗和山写活了，「千秋」「万里」写出时空的辽阔。"
  },
  {
   "text": "毕竟西湖六月中，风光不与四时同。",
   "note": "总写西湖六月的风光独特，「毕竟」强调语气。"
  },
  {
   "text": "接天莲叶无穷碧，映日荷花别样红。",
   "note": "写莲叶和荷花。一「碧」一「红」，色彩对比强烈，画面壮美。"
  }
 ],
 "sentences": [
  {
   "sentence": "窗含西岭千秋雪，门泊东吴万里船。",
   "analysis": "一个「含」字，把窗框当成画框，把远处的雪山「装」了进来，构思极妙。「千秋」写时间之久，「万里」写空间之远，小小一窗一门，竟容下了千年万里，气魄很大。"
  },
  {
   "sentence": "接天莲叶无穷碧，映日荷花别样红。",
   "analysis": "「接天」写莲叶无边无际、与天相接，「无穷碧」和「别样红」把绿与红推到极致。绿得铺天盖地，红得格外耀眼，是全诗最壮丽的一笔。"
  }
 ],
