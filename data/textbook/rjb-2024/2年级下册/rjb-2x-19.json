 "text": [
  "满天的乌云，黑沉沉地压下来。树上的叶子一动不动，蝉一声也不叫。",
  "忽然一阵大风，吹得树枝乱摆。一只蜘蛛从网上垂下来，逃走了。",
  "闪电越来越亮，雷声越来越响。",
  "哗，哗，哗，雨下起来了。",
  "雨越下越大。往窗外望去，树哇，房子啊，都看不清了。",
  "渐渐地，渐渐地，雷声小了，雨声也小了。",
  "天亮起来了。打开窗户，清新的空气迎面扑来。",
  "雨停了。太阳出来了。一条彩虹挂在天空。蝉叫了。蜘蛛又坐在网上。池塘里的水满了，青蛙也叫起来了。"
 ],
 "summary": "课文按雷雨前、雷雨中、雷雨后的顺序，生动地描写了一场雷雨的全过程。",
 "centerThought": "感受大自然的神奇与美丽，学习按顺序、抓特点观察和描写景物的方法。",
 "segments": [
  {
   "text": "满天的乌云，黑沉沉地压下来。树上的叶子一动不动，蝉一声也不叫。",
   "note": "雷雨前。用「压」「一动不动」「一声也不叫」写闷热、沉闷的气氛。"
  },
  {
   "text": "忽然一阵大风，吹得树枝乱摆。一只蜘蛛从网上垂下来，逃走了。",
   "note": "写大风来临，「乱摆」「逃走」写出风雨将至时的慌乱。"
  },
  {
   "text": "闪电越来越亮，雷声越来越响。",
   "note": "两个「越来越」写雨前的紧张气氛不断升级。"
  },
  {
   "text": "哗，哗，哗，雨下起来了。",
   "note": "用拟声词写雨，「哗，哗，哗」节奏急促，雨来得又快又猛。"
  },
  {
   "text": "雨越下越大。往窗外望去，树哇，房子啊，都看不清了。",
   "note": "雷雨中。写雨大，「看不清」从侧面写雨大。"
  },
  {
   "text": "渐渐地，渐渐地，雷声小了，雨声也小了。",
   "note": "「渐渐地」写雨小了，节奏慢下来，过渡到雨后。"
  },
  {
   "text": "雨停了。太阳出来了。一条彩虹挂在天空。",
   "note": "雷雨后。一个「挂」字让彩虹有了画面感。"
  },
  {
   "text": "池塘里的水满了，青蛙也叫起来了。",
   "note": "写雨后生机勃勃，与雨前的沉闷形成对比。"
  }
 ],
 "sentences": [
  {
   "sentence": "满天的乌云，黑沉沉地压下来。",
   "analysis": "一个「压」字用得极准，乌云低垂压顶的感觉一下就出来了，读着都觉得闷。这是雷雨前最典型的景象。"
  },
  {
   "sentence": "闪电越来越亮，雷声越来越响。",
   "analysis": "两个「越来越」，把雷雨由远及近、不断逼近的过程一句句推上去，读起来越来越紧张。"
  }
 ],
