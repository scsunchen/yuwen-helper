 "centerThought": "了解中国美食和烹饪方法，认识火字旁、四点底等与「火」有关的字，感受中华饮食文化的丰富。",
 "segments": [
  {
   "text": "中国美食种类多，煎炒烹炸花样多。",
   "note": "总写中国美食多、做法多，引出下文的烹饪方法。"
  },
  {
   "text": "蒸煮炖焖种种香，",
   "note": "「蒸、煮、炖、焖」都跟火有关，字多带火字旁或四点底。"
  },
  {
   "text": "（识字重点：煎、烤、煮、蒸、炖、炸、炒、拌）",
   "note": "这一课要重点识记这些表示烹饪方法的字，并发现它们与「火」的关系。"
  }
 ],
 "sentences": [
  {
   "sentence": "煎、烤、煮、蒸、炖、炸……这些字有什么共同点？",
   "analysis": "「烤、炖、炸」是火字旁，「煎、蒸、煮」下面是四点底。它们都跟「火」有关，都是有火才能做的动作，发现这个规律就一下子记住了一片字。"
  }
 ],
