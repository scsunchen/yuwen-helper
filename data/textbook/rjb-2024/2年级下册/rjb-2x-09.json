 "text": [
  "春节到，人欢笑，",
  "贴窗花，放鞭炮。",
  "元宵节，看花灯，",
  "大街小巷人如潮。",
  "清明节，雨纷纷，",
  "先人墓前去祭扫。",
  "过端午，赛龙舟，",
  "粽子艾香满堂飘。",
  "七月七，来乞巧，",
  "牛郎织女会鹊桥。",
  "过中秋，吃月饼，",
  "十五圆月当空照。",
  "重阳节，要敬老，",
  "踏秋赏菊去登高。",
  "转眼又是新春到，",
  "全家团圆真热闹。"
 ],
 "summary": "按时间顺序介绍了春节、元宵、清明、端午、七夕、中秋、重阳等传统节日的习俗。",
 "centerThought": "了解中华民族的传统节日和习俗，感受传统文化的丰富多彩，增强民族自豪感。",
 "segments": [
  {
   "text": "春节到，人欢笑，贴窗花，放鞭炮。",
   "note": "写春节习俗：贴窗花、放鞭炮，一个「欢笑」写出喜庆的气氛。"
  },
  {
   "text": "元宵节，看花灯，大街小巷人如潮。",
   "note": "写元宵节看花灯，「人如潮」写出热闹的景象。"
  },
  {
   "text": "清明节，雨纷纷，先人墓前去祭扫。",
   "note": "写清明祭扫先人，表达对先人的怀念。"
  },
  {
   "text": "过端午，赛龙舟，粽子艾香满堂飘。",
   "note": "写端午节赛龙舟、吃粽子、插艾草，很有画面感。"
  },
  {
   "text": "七月七，来乞巧，牛郎织女会鹊桥。",
   "note": "写七夕节的传说，牛郎织女鹊桥相会。"
  },
  {
   "text": "过中秋，吃月饼，十五圆月当空照。",
   "note": "写中秋吃月饼、赏圆月，圆月象征团圆。"
  },
  {
   "text": "重阳节，要敬老，踏秋赏菊去登高。",
   "note": "写重阳节敬老、登高、赏菊。"
  },
  {
   "text": "转眼又是新春到，全家团圆真热闹。",
   "note": "结尾回到春节，首尾呼应，写团圆的热闹。"
  }
 ],
