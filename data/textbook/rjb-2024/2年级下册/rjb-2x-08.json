 "text": [
  "我神州，称中华，",
  "山川美，可入画。",
  "黄河奔，长江涌，",
  "长城长，珠峰耸。",
  "台湾岛，隔海峡，",
  "与大陆，是一家。",
  "各民族，情谊浓，",
  "齐奋发，共繁荣。"
 ],
 "summary": "以三字经的形式，介绍了祖国壮美的山河、宝岛台湾和民族团结，表达了对祖国的赞美。",
 "centerThought": "歌颂祖国山川壮美、民族团结，表达期盼祖国统一、共同繁荣的心愿。",
 "segments": [
  {
   "text": "我神州，称中华，山川美，可入画。",
   "note": "总写祖国山川美丽，像画一样美。"
  },
  {
   "text": "黄河奔，长江涌，长城长，珠峰耸。",
   "note": "用四个动词「奔、涌、长、耸」写四处代表性景物的特点。"
  },
  {
   "text": "台湾岛，隔海峡，与大陆，是一家。",
   "note": "写宝岛台湾与大陆血脉相连，是一家人。"
  },
  {
   "text": "各民族，情谊浓，齐奋发，共繁荣。",
   "note": "写各民族团结一心，共同奋斗、共同繁荣。"
  }
 ],
 "sentences": [
  {
   "sentence": "黄河奔，长江涌，长城长，珠峰耸。",
   "analysis": "四个短句一气呵成，用「奔、涌、长、耸」四个动词，分别写出黄河的急、长江的壮、长城的绵延、珠峰的高耸，节奏铿锵，气势磅礴。"
  },
  {
   "sentence": "台湾岛，隔海峡，与大陆，是一家。",
