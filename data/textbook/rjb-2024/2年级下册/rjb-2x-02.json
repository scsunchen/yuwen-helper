 "text": [
  "春天来了！春天来了！",
  "我们几个孩子脱掉棉袄，冲出家门，奔向田野，去寻找春天。",
  "春天像个害羞的小姑娘，遮遮掩掩，躲躲藏藏。我们仔细地找哇，找哇。",
  "小草从地下探出头来，那是春天的眉毛吧？",
  "早开的野花一朵两朵，那是春天的眼睛吧？",
  "树木吐出点点嫩芽，那是春天的音符吧？",
  "解冻的小溪叮叮咚咚，那是春天的琴声吧？",
  "春天来了！我们看到了她，我们听到了她，我们闻到了她，我们触到了她。她在柳枝上荡秋千，在风筝尾巴上摇哇摇；她在喜鹊、杜鹃嘴里叫，在桃花、杏花枝头笑……"
 ],
 "summary": "孩子们怀着喜悦的心情去寻找春天，从草芽、野花、嫩芽、小溪和柳枝、风筝等景物中发现了春天的踪迹。",
 "centerThought": "表达了对春天的喜爱、赞美，以及发现春天时的无比喜悦之情。",
 "segments": [
  {
   "text": "春天来了！春天来了！",
   "note": "反复呼喊，表达发现春天时抑制不住的兴奋。"
  },
  {
   "text": "我们几个孩子脱掉棉袄，冲出家门，奔向田野，去寻找春天。",
   "note": "「脱、冲、奔、寻」一连串动词，写出孩子们急切、欢快的心情。"
  },
  {
   "text": "春天像个害羞的小姑娘，遮遮掩掩，躲躲藏藏。",
   "note": "把春天比作害羞的小姑娘，说明春天要仔细寻找才能发现。"
  },
  {
   "text": "小草从地下探出头来……那是春天的琴声吧？",
   "note": "四个比喻句，把草芽、野花、嫩芽、小溪分别比作眉毛、眼睛、音符、琴声，从看到听写出春天的美好。"
  },
  {
   "text": "春天来了！我们看到了她，我们听到了她，我们闻到了她，我们触到了她。",
   "note": "用看、听、闻、触四个动词，写出孩子们用各种感官感受春天。"
  },
  {
   "text": "她在柳枝上荡秋千，在风筝尾巴上摇哇摇……",
   "note": "用拟人写春天无处不在，充满生机与快乐。"
  }
 ],
