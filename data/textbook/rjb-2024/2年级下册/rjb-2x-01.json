 "text": [
  "咏柳",
  "[唐] 贺知章",
  "碧玉妆成一树高，万条垂下绿丝绦。",
  "不知细叶谁裁出，二月春风似剪刀。",
  "",
  "村居",
  "[清] 高鼎",
  "草长莺飞二月天，拂堤杨柳醉春烟。",
  "儿童散学归来早，忙趁东风放纸鸢。"
 ],
 "summary": "《咏柳》借柳树赞美春天，把春风比作剪刀，想象奇特；《村居》描绘春天乡村孩子放风筝的欢乐画面。",
 "centerThought": "感受春天的生机与美丽，体会诗人对春天的喜爱和赞美之情。",
 "segments": [
  {
   "text": "碧玉妆成一树高，万条垂下绿丝绦。",
   "note": "把柳树比作碧玉装扮的美人，「绿丝绦」写出柳条又细又软、随风飘动的样子。"
  },
  {
   "text": "不知细叶谁裁出，二月春风似剪刀。",
   "note": "一问一答，把春风比作剪刀，说柳叶是春风裁出来的，想象特别巧妙。"
  },
  {
   "text": "草长莺飞二月天，拂堤杨柳醉春烟。",
   "note": "写二月乡村的春景：草生长、黄莺飞、杨柳拂堤。「醉」字写出杨柳在春烟中迷醉的样子。"
  },
  {
   "text": "儿童散学归来早，忙趁东风放纸鸢。",
   "note": "写孩子们放学后赶快放风筝，一个「忙」字写出急切、快乐的心情。"
  }
 ],
 "sentences": [
  {
   "sentence": "碧玉妆成一树高，万条垂下绿丝绦。",
   "analysis": "用比喻写柳树：「碧玉」写颜色翠绿，「绿丝绦」写柳条细软下垂。一「妆」字把柳树当人来写，生动可爱。"
  },
  {
   "sentence": "不知细叶谁裁出，二月春风似剪刀。",
   "analysis": "自问自答，把无形的春风比作剪刀，把柳叶说成是裁出来的，化无形为有形，是全诗最妙的一笔。"
  }
 ],
