 "text": [
  "登鹳雀楼",
  "［唐］王之涣",
  "白日依山尽，黄河入海流。",
  "欲穷千里目，更上一层楼。",
  "",
  "望庐山瀑布",
  "［唐］李白",
  "日照香炉生紫烟，遥看瀑布挂前川。",
  "飞流直下三千尺，疑是银河落九天。"
 ],
 "summary": "《江雪》描绘了大雪覆盖、万籁俱寂的江面上，一位蓑笠翁独自垂钓的清冷画面；《敕勒歌》描绘了敕勒川辽阔壮美的草原景色和牧民生活。",
 "centerThought": "感受《江雪》中孤高清冷的意境和诗人不屈的精神，体会《敕勒歌》草原的辽阔壮美，领略古诗的画面之美。",
 "segments": [
  {
   "text": "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。",
   "note": "前两句写景：太阳依着山头慢慢落下，黄河奔流入海，画面开阔、气势雄浑。后两句说理：想望得更远，就要再登上一层楼——站得高，才能看得远。"
  },
  {
   "text": "日照香炉生紫烟，遥看瀑布挂前川。飞流直下三千尺，疑是银河落九天。",
   "note": "「生紫烟」写香炉峰云雾缭绕；「挂」字化动为静，写出瀑布垂挂山前的样子；「三千尺」夸张写其高，「疑是银河落九天」以想象收束，气象壮阔。"
  }
 ],
 "sentences": [
  {
   "sentence": "孤舟蓑笠翁，独钓寒江雪。",
   "analysis": "「孤」「独」点出环境的冷清与渔翁的孤傲，一个「钓」字把静止的雪景写活，画面清冷而有意境。"
  },
  {
   "sentence": "天苍苍，野茫茫，风吹草低见牛羊。",
   "analysis": "前两句是静态的辽阔，末句中「吹」「低」「见」三个动作让画面活起来，牛羊的出现带来生机。"
  }
 ],
