 "text": [
  "江雪",
  "［唐］柳宗元",
  "千山鸟飞绝，万径人踪灭。",
  "孤舟蓑笠翁，独钓寒江雪。",
  "",
  "敕勒歌",
  "北朝民歌",
  "敕勒川，阴山下。",
  "天似穹庐，笼盖四野。",
  "天苍苍，野茫茫，风吹草低见牛羊。"
 ],
 "summary": "《江雪》描绘了大雪覆盖、万籁俱寂的江面上，一位蓑笠翁独自垂钓的清冷画面；《敕勒歌》描绘了敕勒川辽阔壮美的草原景色和牧民生活。",
 "centerThought": "感受《江雪》中孤高清冷的意境和诗人不屈的精神，体会《敕勒歌》草原的辽阔壮美，领略古诗的画面之美。",
 "segments": [
  {
   "text": "千山鸟飞绝，万径人踪灭。",
   "note": "写雪后天地之静：「千山」「万径」写范围之广，「绝」「灭」写飞鸟、行人的踪迹全无，突出大雪覆盖、万籁俱寂。"
  },
  {
   "text": "孤舟蓑笠翁，独钓寒江雪。",
   "note": "写人：一叶「孤舟」、一位「蓑笠翁」，「独钓」在寒冷的江雪之中，以「孤」「独」写出环境的冷清与渔翁的孤傲。"
  },
  {
   "text": "敕勒川，阴山下。天似穹庐，笼盖四野。",
   "note": "先写草原位置，再把天空比作「穹庐」（圆顶帐篷），写出天高地阔。"
  },
  {
   "text": "天苍苍，野茫茫，风吹草低见牛羊。",
   "note": "写草原景象：「苍苍」「茫茫」写辽阔，末句由静态转为动态，牛羊隐现于草丛中。"
  }
 ],
 "sentences": [
  {
   "sentence": "孤舟蓑笠翁，独钓寒江雪。",
   "analysis": "「孤」「独」点出环境的冷清与渔翁的孤傲，一个「钓」字把静止的雪景写活，画面清冷而有意境。"
  },
  {
   "sentence": "天苍苍，野茫茫，风吹草低见牛羊。",
   "analysis": "前两句是静态的辽阔，末句中「吹」「低」「见」三个动作让画面活起来，牛羊的出现带来生机。"
  }
 ],
