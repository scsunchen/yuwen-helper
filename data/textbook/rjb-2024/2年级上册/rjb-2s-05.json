 "text": [
  "杨树高，榕树壮，",
  "梧桐树叶像手掌。",
  "枫树秋天叶儿红，",
  "松柏四季披绿装。",
  "木棉喜暖在南方，",
  "桦树耐寒守北疆。",
  "银杏水杉活化石，",
  "金桂开花满院香。"
 ],
 "summary": "这是一首介绍树木特征的儿歌，用简洁的语言写出杨树、榕树、梧桐、枫树、松柏、木棉、桦树、银杏、水杉、金桂等树木的特点。",
 "centerThought": "认识常见树木的外形和习性特点，感受大自然的神奇，培养爱护树木、热爱自然的情感。",
 "segments": [
  {
   "text": "杨树高，榕树壮，梧桐树叶像手掌。",
   "note": "写三种树的外形：杨树「高」、榕树「壮」、梧桐叶形如「手掌」，用比喻帮助记忆。"
  },
  {
   "text": "枫树秋天叶儿红，松柏四季披绿装。",
   "note": "对比写叶色变化：枫树秋天变红，松柏四季常青，「披绿装」是拟人。"
  },
  {
   "text": "木棉喜暖在南方，桦树耐寒守北疆。",
   "note": "写生长习性：南方的木棉喜暖，北疆的桦树耐寒，「守」字写出桦树的坚毅。"
  },
  {
   "text": "银杏水杉活化石，金桂开花满院香。",
   "note": "写稀有树种和花木。银杏、水杉被称为「活化石」；金桂以「满院香」写其芬芳。"
  }
 ],
 "sentences": [
  {
   "sentence": "梧桐树叶像手掌。",
   "analysis": "把梧桐叶比作手掌，既写出叶片宽大、分裂的形状，又方便小朋友记忆，比喻贴切。"
  },
  {
   "sentence": "银杏水杉活化石。",
   "analysis": "「活化石」指古老而珍稀、延续至今的物种，一个词就点明这两种树的科学价值。"
  }
 ],
