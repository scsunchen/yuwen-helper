 "text": [
  "一只海鸥，一片沙滩。",
  "一艘军舰，一条帆船。",
  "一方鱼塘，一块稻田。",
  "一行垂柳，一座花园。",
  "一道小溪，一孔石桥。",
  "一丛翠竹，一群飞鸟。",
  "一面队旗，一把铜号。",
  "一队「红领巾」，一片欢笑。"
 ],
 "summary": "课文是一组数量词组成的儿歌，用不同的量词描绘海边、乡村、公园和校园的美丽场景，帮助小朋友认识量词的用法。",
 "centerThought": "在朗读和想象中感受不同场景的美好，学习正确使用量词，体会量词与事物的搭配规律。",
 "segments": [
  {
   "text": "一只海鸥，一片沙滩。一艘军舰，一条帆船。",
   "note": "海边场景。量词「只、片、艘、条」分别与海鸥、沙滩、军舰、帆船搭配。"
  },
  {
   "text": "一方鱼塘，一块稻田。一行垂柳，一座花园。",
   "note": "乡村场景。「方、块、行、座」写出鱼塘、稻田、垂柳、花园的样子。"
  },
  {
   "text": "一道小溪，一孔石桥。一丛翠竹，一群飞鸟。",
   "note": "公园场景。「道、孔、丛、群」准确描绘景物特征。"
  },
  {
   "text": "一面队旗，一把铜号。一队「红领巾」，一片欢笑。",
   "note": "校园活动场景。「红领巾」代指少先队员，用「一片欢笑」收束，画面热闹欢快。"
  }
 ],
 "sentences": [
  {
   "sentence": "一队「红领巾」，一片欢笑。",
   "analysis": "「红领巾」加引号，借代少先队员，不直接说「少先队员」更显亲切；「一片欢笑」把听觉写进画面，收尾明亮。"
  },
  {
   "sentence": "一道小溪，一孔石桥。",
   "analysis": "「道」写小溪的细长，「孔」写石桥的拱形洞口，量词用得准确，换一个就不贴切了。"
  }
 ],
 "skills": [
  "正确认读本课量词",
  "按场景想象画面，读出节奏",
  "积累并尝试运用常见量词"
