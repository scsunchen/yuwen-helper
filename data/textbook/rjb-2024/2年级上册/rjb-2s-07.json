 "text": [
  "春季里，春风吹，",
  "花开草长蝴蝶飞。",
  "麦苗儿多嫩，桑叶儿正肥。",
  "夏季里，农事忙，",
  "采桑养蚕又插秧。",
  "早起勤耕作，归来戴月光。",
  "秋季里，稻上场，",
  "谷像黄金粒粒香。",
  "身体虽辛苦，心里喜洋洋。",
  "冬季里，雪初晴，",
  "新制棉衣暖又轻。",
  "一年农事了，大家笑盈盈。"
 ],
 "summary": "课文是一首时序歌，按春夏秋冬的顺序描写农家的农事活动和四季景色，反映了农民辛勤劳动和丰收的喜悦。",
 "centerThought": "了解农事活动的季节特点，体会农民辛勤劳作的不易和丰收的快乐，懂得珍惜劳动成果。",
 "segments": [
  {
   "text": "春季里，春风吹……桑叶儿正肥。",
   "note": "写春季景色：春风、花开、草长、蝴蝶飞，麦苗嫩、桑叶肥，充满生机。"
  },
  {
   "text": "夏季里，农事忙……归来戴月光。",
   "note": "写夏季农忙：采桑养蚕、插秧，「早起」「戴月光」写出劳动时间长、非常辛苦。"
  },
  {
   "text": "秋季里，稻上场……心里喜洋洋。",
   "note": "写秋季丰收：「谷像黄金」用比喻写出稻谷的金黄珍贵，「喜洋洋」写出喜悦心情。"
  },
  {
   "text": "冬季里，雪初晴……大家笑盈盈。",
   "note": "写冬季农闲：新棉衣「暖又轻」，一年农事结束，「笑盈盈」写出满足和幸福。"
  }
 ],
 "sentences": [
  {
   "sentence": "早起勤耕作，归来戴月光。",
   "analysis": "「戴月光」是说回家时已经很晚，月亮都出来了。不说「天黑了」而说「戴月光」，把辛苦写得富有诗意。"
  },
  {
   "sentence": "谷像黄金粒粒香。",
   "analysis": "把稻谷比作黄金，既写出颜色金黄，又说明粮食珍贵；「粒粒香」让人仿佛闻到新米的香味。"
  }
 ],
