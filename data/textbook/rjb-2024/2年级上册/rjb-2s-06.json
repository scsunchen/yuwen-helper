 "skim": false,
 "author": "",
 "text": [
  "你拍一，我拍一，",
  "动物世界很新奇。",
  "你拍二，我拍二，",
  "孔雀锦鸡是伙伴。",
  "你拍三，我拍三，",
  "雄鹰飞翔云彩间。",
  "你拍四，我拍四，",
  "天空雁群会写字。",
  "你拍五，我拍五，",
  "丛林深处有猛虎。",
  "你拍六，我拍六，",
  "黄鹂百灵唱不休。",
  "你拍七，我拍七，",
  "竹林熊猫在嬉戏。",
  "你拍八，我拍八，",
  "大小动物都有家。",
  "你拍九，我拍九，",
  "人和动物是朋友。",
  "你拍十，我拍十，",
  "保护动物是大事。"
 ],
 "summary": "这是一首拍手歌，用「你拍一，我拍一」的形式，介绍了孔雀、锦鸡、雄鹰、大雁、猛虎、黄鹂、百灵、熊猫等动物，告诉我们要保护动物，做动物的好朋友。",
 "centerThought": "认识多种动物的特点，感受动物世界的奇妙，懂得动物是人类的朋友，要关爱和保护动物。",
 "segments": [
  {
   "text": "你拍一，我拍一，动物世界很新奇。",
   "note": "总起句，点出「动物世界很新奇」，引出下文。"
  },
  {
   "text": "你拍二～你拍五",
   "note": "依次写孔雀锦鸡、雄鹰、雁群、猛虎，从天上到丛林，各有特点。"
  },
  {
   "text": "你拍六，我拍六，黄鹂百灵唱不休。",
   "note": "写鸟类善鸣，「唱不休」把鸟鸣比作歌唱。"
  },
  {
   "text": "你拍七，我拍七，竹林熊猫在嬉戏。",
   "note": "写熊猫的生活环境和动作，「嬉戏」写出活泼可爱。"
  },
  {
   "text": "你拍九～你拍十",
   "note": "升华主题：点明「人和动物是朋友」，保护动物是大事。"
  }
 ],
 "sentences": [
  {
   "sentence": "天空雁群会写字。",
   "analysis": "大雁飞行时排成「一」字或「人」字，作者说它们「会写字」，充满了儿童的天真想象。"
  },
  {
   "sentence": "黄鹂百灵唱不休。",
   "analysis": "「不休」就是不停，把鸟叫声说成「唱」，写出鸟鸣悦耳，也表现出大自然的生机。"
  }
 ],
